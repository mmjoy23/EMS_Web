# --- UniEvents API environment ---
# SQLite database file (relative to the /server directory)
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign JWT session cookies. Change this in any real deployment.
JWT_SECRET="unievents-dev-secret-change-me"

# Port the API listens on (the Vite dev server proxies /api here)
PORT=4000

# Origin allowed for CORS with credentials (the Vite dev client)
CLIENT_ORIGIN="http://localhost:5173"

# --- Email (Outbox mode) ---
# Leave SMTP_URL empty to keep "Outbox" mode: emails are rendered and stored in the
# database instead of being sent, and are viewable in the in-app Outbox.
# To send for real later, install nodemailer and set e.g.
#   SMTP_URL="smtp://user:pass@smtp.example.com:587"
SMTP_URL=""
